# A manual Sidereal run: POST /api/runs (systemctl --user start --no-block
# sidereal-run-manual.service). Same as sidereal-run.service except --trigger manual.
[Unit]
Description=Sidereal pipeline run (manual)

[Service]
Type=oneshot
ExecStart=%h/Projects/Sidereal/.venv/bin/sidereal run --trigger manual
EnvironmentFile=-%h/.config/sidereal/env
Environment=PYTHONDONTWRITEBYTECODE=1
# Gate wait (max 90 min) + run budget (45 min) + margin; the plan's 2h is too short.
TimeoutStartSec=3h
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/sidereal
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
